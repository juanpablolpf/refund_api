# Gere um segredo com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
PORT=3333
# development | test | production
NODE_ENV=development

# Local: Postgres do docker-compose. Produção: Session pooler do Supabase (porta 5432)
DATABASE_URL="postgresql://docker:docker@localhost:5432/refund?schema=public"

# Endereço do front autorizado a chamar a API (deixe vazio para liberar qualquer origem)
CORS_ORIGIN=

# Comprovantes: "disk" guarda em tmp/uploads; "s3" usa um bucket compatível com S3
STORAGE_DRIVER=disk
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# E-mails ("esqueci minha senha"): "log" só mostra no terminal; "resend" envia de verdade
MAIL_DRIVER=log
RESEND_API_KEY=
MAIL_FROM=
# Endereço do site nos links dos e-mails (vazio = usa o CORS_ORIGIN)
APP_URL=
