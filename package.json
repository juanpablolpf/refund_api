{
  "name": "refund_api",
  "version": "1.0.0",
  "main": "build/server.js",
  "engines": {
    "node": ">=20.16"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsup src/server.ts src/scripts/create-manager.ts src/scripts/reset-password.ts --out-dir build --clean",
    "start": "node build/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:up": "docker compose up -d",
    "db:migrate": "prisma migrate deploy",
    "create-manager": "tsx --env-file=.env src/scripts/create-manager.ts",
    "create-manager:prod": "tsx --env-file=.env.production src/scripts/create-manager.ts",
    "reset-password": "tsx --env-file=.env src/scripts/reset-password.ts",
    "reset-password:prod": "tsx --env-file=.env.production src/scripts/reset-password.ts",
    "postinstall": "prisma generate",
    "format": "prettier --write src tests"
  },
  "author": "Juan Pablo",
  "license": "ISC",
  "description": "API de solicitação de reembolso",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1144.0",
    "@prisma/client": "^6.2.1",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/supertest": "^7.2.1",
    "prettier": "^3.9.9",
    "prisma": "^6.2.1",
    "supertest": "^7.3.0",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.2.7"
  }
}
