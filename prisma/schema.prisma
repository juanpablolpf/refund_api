generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  employee
  manager
}

enum RefundStatus {
  pending
  approved
  rejected
}

enum Category {
  food
  others
  services
  transport
  accommodation
}

// Cada empresa cliente tem seus próprios usuários, pedidos e convites
model Organization {
  id   String @id @default(uuid())
  name String

  users   User[]
  refunds Refunds[]
  invites Invite[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  @@map("organizations")
}

model User {
  id       String @id @default(uuid())
  name     String
  email    String @unique
  password String

  role            UserRole             @default(employee)
  refunds         Refunds[]            @relation("RefundOwner")
  reviewedRefunds Refunds[]            @relation("RefundReviewer")
  invitesCreated  Invite[]
  passwordResets  PasswordResetToken[]

  // Aumenta quando a senha muda: tokens de login antigos deixam de valer (desconecta outros aparelhos)
  sessionVersion Int @default(0) @map("session_version")

  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id])

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  @@map("users")
}

model Refunds {
  id            String   @id @default(uuid())
  name          String
  // Valor em centavos (R$ 35,50 = 3550) para evitar erro de arredondamento
  amountInCents Int      @map("amount_in_cents")
  category      Category
  filename      String

  status          RefundStatus @default(pending)
  rejectionReason String?      @map("rejection_reason")
  reviewedAt      DateTime?    @map("reviewed_at")

  userId String @map("user_id")
  user   User   @relation("RefundOwner", fields: [userId], references: [id])

  reviewedById String? @map("reviewed_by_id")
  reviewedBy   User?   @relation("RefundReviewer", fields: [reviewedById], references: [id])

  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id])

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  @@index([organizationId, status])
  @@map("refunds")
}

// Link de convite: o gestor gera, manda para a equipe (WhatsApp, e-mail...) e quem abrir se cadastra na empresa
model Invite {
  id    String   @id @default(uuid())
  token String   @unique
  role  UserRole @default(employee)

  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdById String @map("created_by_id")
  createdBy   User   @relation(fields: [createdById], references: [id])

  usesCount Int       @default(0) @map("uses_count")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("invites")
}

// Link de "esqueci minha senha". Guardamos só o hash do token: quem ler o banco não consegue usar o link.
model PasswordResetToken {
  id        String @id @default(uuid())
  tokenHash String @unique @map("token_hash")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("password_reset_tokens")
}
