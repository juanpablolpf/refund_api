generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserRole {
  employee
  manager
}

enum RefundStatus {
  pending
  approved
  rejected
}

enum Category {
  food
  others
  services
  transport
  accommodation
}

model User {
  id       String @id @default(uuid())
  name     String
  email    String @unique
  password String

  role            UserRole  @default(employee)
  refunds         Refunds[] @relation("RefundOwner")
  reviewedRefunds Refunds[] @relation("RefundReviewer")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  @@map("users")
}

model Refunds {
  id            String   @id @default(uuid())
  name          String
  // Valor em centavos (R$ 35,50 = 3550) para evitar erro de arredondamento
  amountInCents Int      @map("amount_in_cents")
  category      Category
  filename      String

  status          RefundStatus @default(pending)
  rejectionReason String?      @map("rejection_reason")
  reviewedAt      DateTime?    @map("reviewed_at")

  userId String @map("user_id")
  user   User   @relation("RefundOwner", fields: [userId], references: [id])

  reviewedById String? @map("reviewed_by_id")
  reviewedBy   User?   @relation("RefundReviewer", fields: [reviewedById], references: [id])

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  @@map("refunds")
}
